# Copy to .env for local runs, or set these as stack environment variables
# in Komodo for deployment. Never commit real values.

# Google OAuth 2.0 client (https://console.cloud.google.com/apis/credentials)
# Authorized JavaScript origin: https://oot.helv.io
# Authorized redirect URI:      https://oot.helv.io/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server settings (defaults shown)
PORT=8080
DB_PATH=/data/oot.sqlite
PUBLIC_URL=https://oot.helv.io
